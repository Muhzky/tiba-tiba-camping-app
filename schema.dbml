Enum "attribute_type" {
  "text"
  "enum"
  "number"
  "boolean"
}

Enum "dictionary_kind" {
  "synonym"
  "tag"
  "stopword"
}

Enum "order_channel" {
  "web"
  "pos"
}

Enum "order_status" {
  "pending_payment"
  "paid"
  "processing"
  "shipped"
  "ready_pickup"
  "awaiting_stock"
  "rented"
  "returned"
  "completed"
  "cancelled"
  "expired"
  "refunded"
  "overdue"
}

Enum "payment_status" {
  "pending"
  "paid"
  "failed"
  "refunded"
}

Enum "prefer_mode" {
  "buy"
  "rent"
  "any"
}

Enum "product_event_type" {
  "view"
  "add_cart"
  "favorite"
  "purchase"
}

Enum "rental_unit_status" {
  "available"
  "rented"
  "maintenance"
}

Enum "transaction_mode" {
  "buy"
  "rent"
  "preorder"
}

Enum "user_role" {
  "customer"
  "admin"
}

Table "accounts" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "account_id" text [not null]
  "provider_id" text [not null]
  "user_id" uuid [not null]
  "access_token" text
  "refresh_token" text
  "id_token" text
  "access_token_expires_at" timestamptz
  "refresh_token_expires_at" timestamptz
  "scope" text
  "password" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "addresses" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "label" text
  "recipient" text [not null]
  "phone" text [not null]
  "street" text [not null]
  "city" text [not null]
  "province" text [not null]
  "postal_code" text [not null]
  "is_default" bool [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [type: btree, name: "addresses_user_idx"]
  }
}

Table "attributes" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" text [not null]
  "key" text [unique, not null]
  "type" attribute_type [not null, default: 'text']
  "allowed_values" jsonb
  "weight" float4 [not null, default: 1]
  "is_filterable" bool [not null, default: true]
  "show_in_spec" bool [not null, default: true]
}

Table "audit_logs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "actor_id" uuid
  "action" text [not null]
  "entity" text [not null]
  "entity_id" text
  "diff" jsonb
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    created_at [type: btree, name: "audit_logs_created_idx"]
  }
}

Table "cart_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "variant_id" uuid [not null]
  "mode" transaction_mode [not null, default: 'buy']
  "qty" int4 [not null, default: 1]
  "rent_start" timestamptz
  "rent_end" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [type: btree, name: "cart_items_user_idx"]
  }
}

Table "categories" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "parent_id" uuid
  "name" text [not null]
  "slug" text [unique, not null]

  Indexes {
    parent_id [type: btree, name: "categories_parent_idx"]
  }
}

Table "dictionary_terms" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "term" text [not null]
  "canonical" text [not null]
  "kind" dictionary_kind [not null, default: 'synonym']
}

Table "favorites" {
  "user_id" uuid [not null]
  "product_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, product_id) [pk, type: btree, name: "favorites_user_id_product_id_pk"]
    user_id [type: btree, name: "favorites_user_idx"]
  }
}

Table "newsletter_subscribers" {
  "email" text [pk, not null]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "order_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "variant_id" uuid [not null]
  "rental_unit_id" uuid
  "name_snapshot" text [not null]
  "unit_price" int4 [not null]
  "qty" int4 [not null, default: 1]
  "rent_start" timestamptz
  "rent_end" timestamptz
  "rent_days" int4

  Indexes {
    order_id [type: btree, name: "order_items_order_idx"]
  }
}

Table "order_status_logs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "from_status" order_status
  "to_status" order_status [not null]
  "actor_id" uuid
  "note" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (order_id, created_at) [type: btree, name: "order_status_logs_order_idx"]
  }
}

Table "orders" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "code" text [unique, not null]
  "user_id" uuid
  "channel" order_channel [not null, default: 'web']
  "type" transaction_mode [not null]
  "status" order_status [not null, default: 'pending_payment']
  "subtotal" int4 [not null, default: 0]
  "discount" int4 [not null, default: 0]
  "shipping_fee" int4 [not null, default: 0]
  "deposit_total" int4 [not null, default: 0]
  "grand_total" int4 [not null, default: 0]
  "payment_status" payment_status [not null, default: 'pending']
  "midtrans_order_id" text
  "paid_at" timestamptz
  "shipping_address" jsonb
  "notes" text
  "created_at" timestamptz [not null, default: `now()`]
  "tracking_no" text
  "customer_name" text
  "returned_at" timestamptz
  "late_days" int4 [not null, default: 0]
  "late_fee" int4 [not null, default: 0]
  "damage_fee" int4 [not null, default: 0]
  "deposit_refunded" int4 [not null, default: 0]

  Indexes {
    status [type: btree, name: "orders_status_idx"]
    (user_id, created_at) [type: btree, name: "orders_user_created_idx"]
  }
}

Table "payments" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "provider" text [not null, default: 'midtrans']
  "gross_amount" int4 [not null]
  "status" payment_status [not null, default: 'pending']
  "raw_notification" jsonb
  "signature_valid" bool [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    order_id [type: btree, name: "payments_order_idx"]
  }
}

Table "product_attribute_values" {
  "product_id" uuid [not null]
  "attribute_id" uuid [not null]
  "value" jsonb [not null]

  Indexes {
    (product_id, attribute_id) [pk, type: btree, name: "product_attribute_values_product_id_attribute_id_pk"]
  }
}

Table "product_events" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" uuid
  "session_id" text
  "product_id" uuid [not null]
  "type" product_event_type [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, created_at) [type: btree, name: "product_events_user_idx"]
  }
}

Table "product_images" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "variant_id" uuid
  "r2_key" text [not null]
  "sort" int4 [not null, default: 0]
  "alt" text [not null, default: '']

  Indexes {
    (product_id, sort) [type: btree, name: "product_images_product_idx"]
  }
}

Table "product_similarity" {
  "product_id" uuid [not null]
  "similar_id" uuid [not null]
  "score" float8 [not null]

  Indexes {
    (product_id, similar_id) [pk, type: btree, name: "product_similarity_product_id_similar_id_pk"]
  }
}

Table "product_variants" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "sku" text [unique, not null]
  "color_name" text
  "color_hex" text
  "size" text
  "stock" int4 [not null, default: 0]
  "sale_price_override" int4

  Indexes {
    product_id [type: btree, name: "product_variants_product_idx"]
  }
}

Table "product_vectors" {
  "product_id" uuid [pk, not null]
  "vector" jsonb [not null]
  "version" int4 [not null, default: 1]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "products" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "category_id" uuid [not null]
  "name" text [not null]
  "slug" text [unique, not null]
  "description" text [not null, default: '']
  "brand_line" text
  "sale_price" int4 [not null]
  "discount_percent" int4 [not null, default: 0]
  "rent_price_per_day" int4
  "rent_deposit" int4 [not null, default: 0]
  "is_sellable" bool [not null, default: true]
  "is_rentable" bool [not null, default: false]
  "is_preorder" bool [not null, default: false]
  "preorder_eta" timestamptz
  "preorder_dp_percent" int4
  "is_active" bool [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (category_id, is_active) [type: btree, name: "products_category_active_idx"]
    created_at [type: btree, name: "products_created_at_idx"]
    name [type: gin, name: "products_name_trgm_idx"]
  }
}

Table "rental_returns" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_item_id" uuid [not null]
  "returned_at" timestamptz [not null, default: `now()`]
  "condition_note" text
  "late_days" int4 [not null, default: 0]
  "late_fee" int4 [not null, default: 0]
  "damage_fee" int4 [not null, default: 0]
  "deposit_refund" int4 [not null, default: 0]
}

Table "rental_units" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "variant_id" uuid [not null]
  "serial_code" text [unique, not null]
  "condition" text [not null, default: 'good']
  "status" rental_unit_status [not null, default: 'available']

